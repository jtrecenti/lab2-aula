# ambiente
comparacao/.venv/
__pycache__/

# caches de renderizacao (o HTML final entra no Git; os intermediarios nao)
/.quarto/
comparacao/.quarto/
slides/.quarto/
comparacao/*_files/
slides/*_files/
comparacao/*.knit.md
comparacao/*.rmarkdown
_site/

# gerados pelo workflow do Pages, nao versionados
site/index.html
exercicios.html

# excel abre arquivo temporario ao lado do original
~$*

# modelos serializados e notebooks intermediarios: sao gerados ao rodar os
# documentos e nao entram no Git (um .joblib de floresta passa de 70 MB)
*.joblib
*.rds
comparacao/*.ipynb
